generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  RECEPTIONIST
  MECHANIC
  MANAGER
}

enum BudgetStatus {
  PENDENTE
  APROVADO
  RECUSADO
  EXPIRADO
}

enum MovementType {
  ENTRADA
  SAIDA
  AJUSTE
}

enum ServiceOrderStatus {
  CRIADA
  EM_DIAGNOSTICO
  AGUARDANDO_APROVACAO
  APROVADA
  EM_EXECUCAO
  FINALIZADA
  CANCELADA
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// Guarda o refresh token em texto puro, como no backend original (RefreshToken.java).
model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique @db.VarChar(512)
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("refresh_tokens")
}

// Substitui a sequence nativa do Postgres (service_order_number_seq) usada no
// backend original para gerar números de OS/orçamento de forma atômica.
// Prisma não expõe sequences diretamente no schema, então usamos uma linha de
// contador atualizada com `increment` dentro de uma transação — o Postgres
// garante atomicidade nesse UPDATE da mesma forma que garantia no nextval().
model Counter {
  name  String @id
  value Int    @default(0)

  @@map("counters")
}

model Client {
  id        String   @id @default(uuid())
  name      String
  cpf       String?  @unique
  phone     String?
  email     String?
  address   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vehicles      Vehicle[]
  budgets       Budget[]
  serviceOrders ServiceOrder[]

  @@map("clients")
}

model Vehicle {
  id        String   @id @default(uuid())
  plate     String   @unique
  brand     String
  model     String
  year      Int
  mileage   Int?
  fuelType  String?  @map("fuel_type")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  clientId String @map("client_id")
  client   Client @relation(fields: [clientId], references: [id])

  budgets       Budget[]
  serviceOrders ServiceOrder[]

  @@map("vehicles")
}

model Mechanic {
  id          String   @id @default(uuid())
  // Liga o perfil de mecânico a uma conta de login (users.role = MECHANIC).
  // Fica nullable porque nem todo registro de mecânico precisa ter login.
  userId      String?  @unique @map("user_id")
  name        String
  specialty   String?
  phone       String?
  isAvailable Boolean  @default(true) @map("is_available")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  serviceOrders ServiceOrder[]

  @@map("mechanics")
}

model Part {
  id             String   @id @default(uuid())
  name           String
  code           String   @unique
  manufacturer   String?
  purchasePrice  Decimal  @map("purchase_price") @db.Decimal(12, 2)
  salePrice      Decimal  @map("sale_price") @db.Decimal(12, 2)
  stockQuantity  Int      @default(0) @map("stock_quantity")
  minimumStock   Int      @default(5) @map("minimum_stock")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  // Lock otimista: sem isso, duas requisições concorrentes de addStock/removeStock
  // podem ler o mesmo stockQuantity e a última a salvar sobrescrever a outra
  // ("lost update"). Toda alteração de estoque faz um UPDATE condicionado a
  // version = <valor lido>, e falha (ConflictException) se o valor já mudou.
  version        Int      @default(0)

  movements InventoryMovement[]

  @@map("parts")
}

model InventoryMovement {
  id               String       @id @default(uuid())
  partId           String       @map("part_id")
  part             Part         @relation(fields: [partId], references: [id])
  type             MovementType
  quantity         Int
  previousQuantity Int          @map("previous_quantity")
  currentQuantity  Int          @map("current_quantity")
  reason           String?
  referenceId      String?      @map("reference_id")
  userId           String?      @map("user_id")
  createdAt        DateTime     @default(now()) @map("created_at")

  @@map("inventory_movements")
}

model Budget {
  id             String       @id @default(uuid())
  budgetNumber   String       @unique @map("budget_number")
  clientId       String       @map("client_id")
  client         Client       @relation(fields: [clientId], references: [id])
  vehicleId      String       @map("vehicle_id")
  vehicle        Vehicle      @relation(fields: [vehicleId], references: [id])
  serviceOrderId String?      @unique @map("service_order_id")
  serviceOrder   ServiceOrder? @relation(fields: [serviceOrderId], references: [id])
  description    String?
  totalAmount    Decimal      @map("total_amount") @db.Decimal(12, 2)
  status         BudgetStatus @default(PENDENTE)
  validUntil     DateTime?    @map("valid_until")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@map("budgets")
}

model ServiceOrder {
  id              String             @id @default(uuid())
  orderNumber     String             @unique @map("order_number")
  clientId        String             @map("client_id")
  client          Client             @relation(fields: [clientId], references: [id])
  vehicleId       String             @map("vehicle_id")
  vehicle         Vehicle            @relation(fields: [vehicleId], references: [id])
  mechanicId      String?            @map("mechanic_id")
  mechanic        Mechanic?          @relation(fields: [mechanicId], references: [id])
  reportedProblem String?            @map("reported_problem")
  diagnosis       String?
  status          ServiceOrderStatus @default(CRIADA)
  totalAmount     Decimal            @default(0) @map("total_amount") @db.Decimal(12, 2)
  startedAt       DateTime?          @map("started_at")
  completedAt     DateTime?          @map("completed_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  budget Budget?

  @@map("service_orders")
}
